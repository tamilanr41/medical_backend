/** Collections only administrators may touch (API + UI guard). */
export const ADMIN_ONLY_COLLECTIONS = new Set([
  "users",
  "roles",
  "permissions",
  "module_access",
  "menu_access",
  "audit_logs",
  "system_configs",
  "backups",
]);

export const MENU_BY_SLUG = new Map(MENU.map((module) => [module.slug, module]));
